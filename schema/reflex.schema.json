{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brida.ai/schemas/reflex/v1alpha1/reflex.schema.json",
  "title": "Brida Reflex recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "brida.ai/reflex/v1alpha1" },
    "kind": { "const": "Reflex" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "displayName"],
      "properties": {
        "name": { "$ref": "#/$defs/reflexId" },
        "version": { "$ref": "#/$defs/version" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataClass", "input", "questionSetRef", "questions", "policyRef", "branches", "authority"],
      "properties": {
        "dataClass": {
          "enum": ["non_sensitive", "sensitive_personal", "regulated_sensitive"]
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxBytes"],
          "properties": {
            "maxBytes": { "type": "integer", "minimum": 1, "maximum": 262144 }
          }
        },
        "questionSetRef": { "$ref": "#/$defs/versionedRef" },
        "questions": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": { "pattern": "^[a-z][A-Za-z0-9_]{0,63}$" },
          "additionalProperties": { "$ref": "#/$defs/question" }
        },
        "policyRef": { "$ref": "#/$defs/versionedRef" },
        "branches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
        },
        "authority": { "const": "recommendation_only" }
      }
    }
  },
  "$defs": {
    "reflexId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,8}$"
    },
    "versionedRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]{0,127}$"
    },
    "instructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "binaryQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "instructions"],
      "properties": {
        "type": { "const": "binary" },
        "instructions": { "$ref": "#/$defs/instructions" },
        "criteria": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "true": { "$ref": "#/$defs/instructions" },
            "false": { "$ref": "#/$defs/instructions" }
          }
        }
      }
    },
    "choiceQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "instructions", "criteria"],
      "properties": {
        "type": { "const": "choice" },
        "instructions": { "$ref": "#/$defs/instructions" },
        "criteria": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 32,
          "propertyNames": { "type": "string", "minLength": 1, "maxLength": 64 },
          "additionalProperties": { "$ref": "#/$defs/instructions" }
        }
      }
    },
    "scoreQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "instructions", "criteria"],
      "properties": {
        "type": { "const": "score" },
        "instructions": { "$ref": "#/$defs/instructions" },
        "criteria": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/instructions" }
        }
      }
    },
    "question": {
      "oneOf": [
        { "$ref": "#/$defs/binaryQuestion" },
        { "$ref": "#/$defs/choiceQuestion" },
        { "$ref": "#/$defs/scoreQuestion" }
      ]
    }
  }
}
