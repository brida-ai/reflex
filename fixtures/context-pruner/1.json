        "redundant": { "type": "binary", "probabilityTrue": 0.99 }
      },
      "expected": { "branch": "keep", "evidenceStatus": "hard_override", "reason": "protected_context" }
    },
    {
      "id": "system-is-kept",
      "mode": "policy",
      "input": { "candidateId": "ctx-system", "protection": "system" },
      "answers": {
        "required": { "type": "binary", "probabilityTrue": 0.01 },
        "redundant": { "type": "binary", "probabilityTrue": 0.99 }
      },
      "expected": { "branch": "keep", "evidenceStatus": "hard_override", "reason": "protected_context" }
    },
    {
      "id": "removable-redundant-is-candidate",
      "mode": "policy",
      "input": { "candidateId": "ctx-summary-copy", "protection": "removable" },
