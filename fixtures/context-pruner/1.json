{
  "schemaVersion": 1,
  "recipe": { "name": "context-pruner", "version": "1" },
  "description": "Synthetic policy fixtures showing that protected context is never a prune candidate.",
  "cases": [
    {
      "id": "pinned-is-kept",
      "mode": "policy",
      "input": { "candidateId": "ctx-pinned", "protection": "pinned" },
